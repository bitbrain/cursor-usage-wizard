{
  "name": "cursor-usage-wizard",
  "version": "0.2.2",
  "description": "Monitor Cursor usage per conversation with status bar, limits, and light-weight cost estimation.",
  "main": "./out/extension.js",
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm install && npm run compile && npx @vscode/vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.70.0",
    "typescript": "^5.0.0"
  },
  "publisher": "bitbrain",
  "icon": "media/icon.webp",
  "repository": {
    "type": "git",
    "url": "https://github.com/bitbrain/cursor-usage-wizard"
  },
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "cursor",
    "usage",
    "monitoring",
    "cost",
    "conversation"
  ],
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cursorUsageWizard.setSessionToken",
        "title": "Cursor Usage Wizard: Set Session Token",
        "icon": "$(key)"
      },
      {
        "command": "cursorUsageWizard.clearSessionToken",
        "title": "Cursor Usage Wizard: Clear Session Token",
        "icon": "$(trash)"
      },
      {
        "command": "cursorUsageWizard.showUsage",
        "title": "Cursor Usage Wizard: Show Usage",
        "icon": "$(graph)"
      },
      {
        "command": "cursorUsageWizard.showConversations",
        "title": "Cursor Usage Wizard: Show Conversations",
        "icon": "$(list-unordered)"
      },
      {
        "command": "cursorUsageWizard.setConversationLimit",
        "title": "Cursor Usage Wizard: Set Conversation Limit",
        "icon": "$(dollar)"
      },
      {
        "command": "cursorUsageWizard.refreshStats",
        "title": "Cursor Usage Wizard: Refresh Stats",
        "icon": "$(sync)"
      },
      {
        "command": "cursorUsageWizard.setLimitForConversation",
        "title": "Set cost limit for this conversation",
        "icon": "$(dollar)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cursorUsageWizard.conversations",
          "title": "Cursor Usage",
          "icon": "$(graph)"
        }
      ]
    },
    "views": {
      "cursorUsageWizard.conversations": [
        {
          "id": "cursorUsageWizard.conversationUsage",
          "name": "By conversation"
        },
        {
          "id": "cursorUsageWizard.conversationDetail",
          "name": "Details",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "cursorUsageWizard.refreshStats",
          "when": "view == cursorUsageWizard.conversationUsage"
        }
      ],
      "view/item/context": [
        {
          "command": "cursorUsageWizard.setLimitForConversation",
          "when": "view == cursorUsageWizard.conversationUsage && viewItem == conversationNode"
        }
      ]
    },
    "configuration": {
      "title": "Cursor Usage Wizard",
      "properties": {
        "cursorUsageWizard.refreshInterval": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "How often to refresh stats (seconds).",
          "scope": "window"
        },
        "cursorUsageWizard.showPerConversationInStatusBar": {
          "type": "boolean",
          "default": false,
          "description": "Show per-conversation count in status bar.",
          "scope": "window"
        },
        "cursorUsageWizard.usageStorePath": {
          "type": "string",
          "default": "",
          "description": "Override usage store path. Leave empty for ~/.cursor/usage-wizard/",
          "scope": "window"
        },
        "cursorUsageWizard.planOverride": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "free", "pro", "pro_plus", "ultra"],
          "description": "Plan tier when API does not expose it. Use 'auto' to infer from API.",
          "scope": "window"
        },
        "cursorUsageWizard.liveTrackingEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Watch usage.jsonl for changes and refresh the conversation list and detail view live.",
          "scope": "window"
        },
        "cursorUsageWizard.showLatestInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the current (active) conversation's cost in the status bar when available (from hook activity), otherwise the latest conversation (e.g. '~$0.42').",
          "scope": "window"
        }
      }
    }
  },
  "extensionKind": [
    "ui"
  ]
}
